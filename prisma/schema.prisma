generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  displayName    String
  bio            String        @default("")
  skills         String        @default("") // comma-separated
  hourlyRate     Float         @default(0)
  accountBalance Float         @default(0)
  publicUserId   String        @unique
  location       String        @default("")
  createdAt      DateTime      @default(now())
  jobsPosted     Job[]
  applications   Application[]
  resumes        Resume[]
}

model Category {
  id                String @id @default(cuid())
  name              String @unique
  typicalHourlyRate Float
  jobs              Job[]
}

model Job {
  id             String        @id @default(cuid())
  title          String
  description    String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  estimatedHours Float
  price          Float
  paymentType    String        @default("FIXED") // FIXED | HOURLY
  hourlyRate     Float?
  currency       String        @default("KES")
  status         String        @default("OPEN") // OPEN|IN_PROGRESS|COMPLETED|CANCELLED
  posterId       String
  poster         User          @relation(fields: [posterId], references: [id])
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model Application {
  id                String   @id @default(cuid())
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id])
  applicantId       String
  applicant         User     @relation(fields: [applicantId], references: [id])
  coverNote         String
  applicantName     String   @default("")
  applicantLocation String   @default("")
  resumeId          String?
  resume            Resume?  @relation(fields: [resumeId], references: [id])
  status            String   @default("PENDING") // PENDING|WISHLISTED|ACCEPTED|DENIED
  createdAt         DateTime @default(now())

  @@unique([jobId, applicantId])
}

model Resume {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  fileName     String
  data         Bytes
  createdAt    DateTime      @default(now())
  applications Application[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
