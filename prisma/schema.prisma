generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  displayName    String
  bio            String        @default("")
  skills         String        @default("") // comma-separated
  hourlyRate     Float         @default(0)
  accountBalance Float         @default(0)
  publicUserId   String        @unique
  createdAt      DateTime      @default(now())
  jobsPosted     Job[]
  applications   Application[]
}

model Category {
  id            String @id @default(cuid())
  name          String @unique
  minHourlyRate Float
  jobs          Job[]
}

model Job {
  id             String        @id @default(cuid())
  title          String
  description    String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  estimatedHours Float
  price          Float
  status         String        @default("OPEN") // OPEN|IN_PROGRESS|COMPLETED|CANCELLED
  posterId       String
  poster         User          @relation(fields: [posterId], references: [id])
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id])
  coverNote   String
  status      String   @default("PENDING") // PENDING|WISHLISTED|ACCEPTED|DENIED
  createdAt   DateTime @default(now())

  @@unique([jobId, applicantId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
